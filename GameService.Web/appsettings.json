{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GameServiceDb;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "StorageSettings": {
    "SecureUploadsPath": "App_Data/SecureUploads",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf" ],
    "MaxFileSizeBytes": 5242880
  },
  "AppSettings": {
    "RequireAdminCompletionApproval": false,
    "AgreementVersion": "v1.0",
    "MinimumAdultAge": 18
  }
}
