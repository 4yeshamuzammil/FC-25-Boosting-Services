@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameBoost Hub</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --gb-primary: #f59e0b;
            --gb-primary-hover: #d97706;
            --gb-dark-bg: #0f172a;
            --gb-card-bg: #1e293b;
            --gb-card-border: #334155;
            --gb-accent: #6366f1;
        }

        body {
            background-color: var(--gb-dark-bg);
            color: #f1f5f9;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #fbbf24 !important;
        }

        .card {
            background-color: var(--gb-card-bg);
            border: 1px solid var(--gb-card-border);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
        }

        .card-header {
            background-color: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--gb-card-border);
            font-weight: 600;
        }

        .btn-warning {
            background-color: var(--gb-primary);
            border-color: var(--gb-primary);
            color: #000;
            font-weight: 600;
        }

        .btn-warning:hover {
            background-color: var(--gb-primary-hover);
            border-color: var(--gb-primary-hover);
            color: #000;
        }

        .table-dark {
            --bs-table-bg: transparent;
            --bs-table-border-color: var(--gb-card-border);
        }

        .badge-status-Open { background-color: #3b82f6; color: #fff; }
        .badge-status-Assigned { background-color: #f59e0b; color: #000; }
        .badge-status-InProgress { background-color: #8b5cf6; color: #fff; }
        .badge-status-Completed { background-color: #10b981; color: #fff; }
        .badge-status-Cancelled { background-color: #ef4444; color: #fff; }

        .legal-notice-bar {
            background: linear-gradient(90deg, #991b1b, #7f1d1d);
            border-left: 5px solid #ef4444;
            color: #fef2f2;
            padding: 1rem 1.25rem;
            border-radius: 8px;
            font-size: 0.95rem;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15);
        }

        .footer {
            margin-top: auto;
            border-top: 1px solid var(--gb-card-border);
            background-color: rgba(15, 23, 42, 0.85);
        }
    </style>
</head>
<body>
    <!-- QUICK DASHBOARD SWITCHER (1-CLICK ACCESS) -->
    <div class="bg-black py-1 px-4 border-bottom border-secondary small d-flex flex-wrap justify-content-between align-items-center">
        <div class="text-secondary d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark fw-bold">QUICK ACCESS</span>
            <span>One-click role switch:</span>
        </div>
        <div class="d-flex align-items-center gap-2 py-1">
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Admin" class="badge bg-danger text-decoration-none py-1 px-2">
                <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
            </a>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Customer" class="badge bg-primary text-decoration-none py-1 px-2">
                <i class="bi bi-cart me-1"></i> Customer Dashboard
            </a>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Player" class="badge bg-warning text-dark text-decoration-none py-1 px-2">
                <i class="bi bi-joystick me-1"></i> Player Hub
            </a>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary-subtle py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-trophy-fill fs-4 text-warning"></i>
                    <span>FC25<span class="text-white">Boosting</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirstValue(ClaimTypes.Role);
                            var category = User.FindFirst("Category")?.Value;

                            if (category == "A" || role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Orders"><i class="bi bi-box-seam me-1"></i> Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Customers"><i class="bi bi-people me-1"></i> Customers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Applications"><i class="bi bi-person-badge me-1"></i> Applications</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Players"><i class="bi bi-trophy me-1"></i> Players & Earnings</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text me-1"></i> Audit Logs</a>
                                </li>
                            }
                            else if (category == "C" || role == "Customer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-1"></i> My Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customer" asp-action="CreateOrder"><i class="bi bi-plus-circle me-1"></i> Place New Order</a>
                                </li>
                            }
                            else if (category == "P" || role == "Player")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Player" asp-action="Dashboard"><i class="bi bi-joystick me-1"></i> Player Hub</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Account" asp-action="JoinTeam">
                                    <i class="bi bi-shield-check me-1"></i> Join Our Team & Earn
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirstValue(ClaimTypes.Role);
                            var category = User.FindFirst("Category")?.Value;
                            string badgeClass = category == "A" ? "bg-danger" : (category == "P" ? "bg-warning text-dark" : "bg-primary");
                            string roleLabel = category == "A" ? "Admin" : (category == "P" ? "Player" : "Customer");

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge @badgeClass rounded-pill">@roleLabel</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li class="dropdown-item-text text-muted small">@User.FindFirstValue(ClaimTypes.Email)</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Customer Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-4 py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer py-3 text-secondary text-center small">
        <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year FC 25 Boosting Services. EA Sports FC 25 Champions & Rivals Pro Management.
            </div>
            <div>
                <a asp-controller="Home" asp-action="Terms" class="text-secondary text-decoration-none me-3">Player Agreement & Terms</a>
                <span class="text-muted">Enterprise Secure Platform</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
