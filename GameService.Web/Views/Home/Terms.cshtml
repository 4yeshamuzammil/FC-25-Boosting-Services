@{
    ViewData["Title"] = "Player Service Agreement & Legal Terms";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-10">
        <div class="card shadow-lg">
            <div class="card-header bg-dark py-3">
                <h4 class="mb-0 text-white"><i class="bi bi-file-earmark-text text-warning me-2"></i>Player Service Agreement & Terms of Conduct (v1.0)</h4>
            </div>
            <div class="card-body p-4 text-light">
                <div class="legal-notice-bar mb-4">
                    <i class="bi bi-shield-exclamation fs-4 me-2"></i>
                    <strong>CRITICAL LEGAL NOTICE:</strong> Customer game accounts are high-priority assets. Any misuse, unauthorized password change, account theft, cheat/script usage leading to a ban, or disclosure of credentials will result in immediate forfeiture of earnings, permanent blacklisting, and severe legal action.
                </div>

                <h5>1. Scope of Independent Contractor Agreement</h5>
                <p class="text-secondary">
                    By submitting the "Join Our Team" application, the applicant enters into a binding legal agreement with GameBoost Hub as an independent verified player / booster. The booster agrees to provide professional gameplay services on client orders adhering strictly to fair-play rules.
                </p>

                <h5>2. Account Integrity and High-Priority Confidentiality</h5>
                <p class="text-secondary">
                    The player agrees that:
                </p>
                <ul class="text-secondary">
                    <li>Client EA / Console credentials provided for boosting must only be used on authorized hardware during the active order execution.</li>
                    <li>No third-party modifications, bots, coin-farming scripts, or exploit tools may ever be used.</li>
                    <li>No spending of customer EA Sports FC currency (FC Coins, FC Points, Draft Tokens) or selling/discarding club squad players is permitted.</li>
                    <li>All packs and player picks earned during Weekend League or Rivals remain untouched in the FUT store for the customer.</li>
                </ul>

                <h5>3. Verification & Compliance Requirements</h5>
                <p class="text-secondary">
                    All adult players must submit verifiable government identification (National ID / CNIC) and gameplay proofs. Minors under 18 must submit verifiable Guardian Consent and Guardian Identification prior to order claiming.
                </p>

                <h5>4. Payout Structure and Forfeiture</h5>
                <p class="text-secondary">
                    Payouts are calculated based on completed order milestones. In the event of a customer dispute caused by player negligence or dishonesty, all pending earnings are subject to immediate freeze and forfeiture.
                </p>

                <div class="mt-4 pt-3 border-top border-secondary text-end">
                    <a asp-controller="Account" asp-action="JoinTeam" class="btn btn-warning">
                        Back to Team Application
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
