@model LoginViewModel
@{
    ViewData["Title"] = "Platform Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-secondary">
            <div class="card-header text-center py-4 bg-dark">
                <i class="bi bi-shield-lock text-warning fs-1 mb-2"></i>
                <h3 class="fw-bold text-white mb-0">Unified Login</h3>
                <p class="text-secondary small mb-0">Sign in as Admin, Customer, or Approved Player</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-secondary small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control bg-dark border-secondary text-white" placeholder="name@domain.com" autocomplete="email" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label text-secondary small fw-semibold"></label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control bg-dark border-secondary text-white" placeholder="••••••••" autocomplete="current-password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                        <label class="form-check-label text-secondary small" for="rememberMeCheck">
                            Remember me on this browser
                        </label>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-bold shadow">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top border-secondary text-center small text-secondary">
                    <p class="mb-2">New customer? <a asp-controller="Account" asp-action="Register" class="text-warning fw-semibold text-decoration-none">Create an Account</a></p>
                    <p class="mb-0">Are you a pro player? <a asp-controller="Account" asp-action="JoinTeam" class="text-info fw-semibold text-decoration-none">Apply to Join Our Team</a></p>
                </div>
            </div>
        </div>

        <!-- Development / Admin Demo Credentials Card -->
        <div class="card mt-3 bg-dark border-secondary">
            <div class="card-body p-3 small text-secondary">
                <div class="fw-bold text-white mb-1"><i class="bi bi-info-circle text-primary me-1"></i> Pre-configured Accounts:</div>
                <div><strong>Admin:</strong> <code>admin@gameboost.com</code> / <code>Admin123!</code></div>
                <div class="text-muted mt-1">Automatic role-based redirection will route Admin to <code>/Admin/Dashboard</code>, Customer to <code>/Customer/Dashboard</code>, and Player to <code>/Player/Dashboard</code>.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
