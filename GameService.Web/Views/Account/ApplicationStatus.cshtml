@model PlayerApplication
@{
    ViewData["Title"] = "Application Status";
    string status = Model?.ApplicationStatus ?? "Pending";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-7">
        <div class="card shadow-lg border-secondary">
            <div class="card-header text-center py-4 bg-dark">
                @if (status == "Pending")
                {
                    <i class="bi bi-hourglass-split text-warning fs-1 mb-2"></i>
                    <h3 class="fw-bold text-white mb-0">Application Under Review</h3>
                    <p class="text-secondary small mb-0">Our administration team is currently reviewing your verification documents</p>
                }
                else if (status == "Rejected")
                {
                    <i class="bi bi-x-circle text-danger fs-1 mb-2"></i>
                    <h3 class="fw-bold text-white mb-0">Application Not Approved</h3>
                    <p class="text-secondary small mb-0">Your application did not pass our current verification standards</p>
                }
                else
                {
                    <i class="bi bi-check-circle text-success fs-1 mb-2"></i>
                    <h3 class="fw-bold text-white mb-0">Application Approved!</h3>
                    <p class="text-secondary small mb-0">You are an authorized booster on GameBoost Hub</p>
                }
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="mb-4 text-center">
                    <span class="fs-6 text-secondary me-2">Status:</span>
                    @if (status == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">Pending Review</span>
                    }
                    else if (status == "Rejected")
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">Application Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">Approved</span>
                    }
                </div>

                @if (status == "Pending")
                {
                    <div class="alert alert-info border-0 bg-dark text-light p-4 rounded mb-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-info-circle-fill fs-3 text-info"></i>
                            <div>
                                <h6 class="text-white fw-bold">Verification in Progress</h6>
                                <p class="small text-secondary mb-0">
                                    Submitted on <strong>@(Model?.CreatedAt.ToString("MMM dd, yyyy HH:mm") ?? "Recently") UTC</strong>.
                                    Our security team manually validates gameplay rank credentials and identity documents to maintain our strict client account safety standards. Reviews typically take 2-12 hours.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="legal-notice-bar mb-4">
                        <i class="bi bi-shield-lock me-2"></i>
                        Notice: While under review, your access is limited until an administrator verifies your application. Once approved, you will have immediate access to claim available customer boosting orders.
                    </div>
                }
                else if (status == "Rejected")
                {
                    <div class="alert alert-danger border-0 bg-dark text-light p-4 rounded mb-4">
                        <h6 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Admin Feedback</h6>
                        <p class="small text-secondary mb-0">
                            @(string.IsNullOrWhiteSpace(Model?.AdminRemarks) ? "Your identity documents or gameplay proof did not meet our verification criteria." : Model.AdminRemarks)
                        </p>
                    </div>
                }
                else
                {
                    <div class="text-center my-4">
                        <a asp-controller="Player" asp-action="Dashboard" class="btn btn-warning btn-lg px-4 shadow">
                            <i class="bi bi-speedometer2 me-2"></i> Enter Player Dashboard
                        </a>
                    </div>
                }

                <div class="text-center pt-3 border-top border-secondary">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm px-4">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
