@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Center";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-white fw-bold mb-0"><i class="bi bi-speedometer2 text-warning me-2"></i>Admin Operations Dashboard</h2>
        <p class="text-secondary small mb-0">Platform performance, real-time order tracking, and booster overview</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="Applications" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-person-badge me-1"></i> Review Applications (@Model.PendingPlayerApplications)
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-warning btn-sm">
            <i class="bi bi-box-seam me-1"></i> Manage All Orders
        </a>
    </div>
</div>

<!-- TOP KPI CARDS -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Orders -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small text-uppercase fw-semibold">Total Orders</span>
                        <h3 class="text-white fw-bold mb-0 mt-1">@Model.TotalOrdersReceived</h3>
                        <div class="text-info small mt-1">
                            <i class="bi bi-calendar-event me-1"></i><strong>@Model.OrdersThisMonth</strong> this month
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-25 p-3 rounded-circle text-primary">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Revenue This Month -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small text-uppercase fw-semibold">Month Revenue</span>
                        <h3 class="text-success fw-bold mb-0 mt-1">$@Model.TotalAmountThisMonth.ToString("N2")</h3>
                        <div class="text-secondary small mt-1">
                            All-time: $@Model.AllTimeAmount.ToString("N2")
                        </div>
                    </div>
                    <div class="bg-success bg-opacity-25 p-3 rounded-circle text-success">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Customers -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small text-uppercase fw-semibold">Active Customers</span>
                        <h3 class="text-white fw-bold mb-0 mt-1">@Model.TotalCustomers</h3>
                        <div class="text-secondary small mt-1">
                            Category 'C' accounts
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-25 p-3 rounded-circle text-warning">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Approved Players & Pending Apps -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small text-uppercase fw-semibold">Approved Boosters</span>
                        <h3 class="text-white fw-bold mb-0 mt-1">@Model.TotalApprovedPlayers</h3>
                        <div class="text-warning small mt-1">
                            <i class="bi bi-hourglass-split me-1"></i><strong>@Model.PendingPlayerApplications</strong> applications pending
                        </div>
                    </div>
                    <div class="bg-danger bg-opacity-25 p-3 rounded-circle text-danger">
                        <i class="bi bi-joystick fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ORDERS BY STATUS BREAKDOWN -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-secondary">
            <div class="card-header bg-dark d-flex justify-content-between align-items-center">
                <span class="text-white fw-bold"><i class="bi bi-pie-chart text-warning me-2"></i>Orders Pipeline Status</span>
                <span class="small text-secondary">Live breakdown</span>
            </div>
            <div class="card-body">
                <div class="row g-2 text-center">
                    @{
                        string[] statuses = { "Open", "Assigned", "InProgress", "Completed", "Cancelled" };
                        foreach (var st in statuses)
                        {
                            int count = Model.OrdersByStatus.ContainsKey(st) ? Model.OrdersByStatus[st] : 0;
                            string badgeCls = st switch {
                                "Open" => "text-primary border-primary",
                                "Assigned" => "text-warning border-warning",
                                "InProgress" => "text-info border-info",
                                "Completed" => "text-success border-success",
                                "Cancelled" => "text-danger border-danger",
                                _ => "text-secondary border-secondary"
                            };

                            <div class="col">
                                <div class="p-3 rounded border @badgeCls bg-dark">
                                    <div class="fs-4 fw-bold">@count</div>
                                    <div class="small text-secondary text-uppercase fw-semibold">@st</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MONTHLY CHART & RECENT ORDERS -->
<div class="row g-4 mb-4">
    <!-- Chart -->
    <div class="col-lg-6">
        <div class="card border-secondary h-100">
            <div class="card-header bg-dark">
                <span class="text-white fw-bold"><i class="bi bi-bar-chart-line text-warning me-2"></i>Orders & Revenue (Last 6 Months)</span>
            </div>
            <div class="card-body p-3">
                <canvas id="monthlyTrendChart" height="230"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-6">
        <div class="card border-secondary h-100">
            <div class="card-header bg-dark d-flex justify-content-between align-items-center">
                <span class="text-white fw-bold"><i class="bi bi-clock-history text-warning me-2"></i>Recent Orders</span>
                <a asp-controller="Admin" asp-action="Orders" class="text-warning small text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-secondary text-secondary small text-uppercase">
                            <tr>
                                <th>#</th>
                                <th>Game & Service</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No orders placed yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold">#@o.Id</td>
                                        <td>
                                            <div class="fw-semibold text-white">@o.GameName</div>
                                            <div class="small text-secondary">@o.ServiceType &bull; @o.TargetRank</div>
                                        </td>
                                        <td>
                                            <div class="small text-white">@o.Customer?.FullName</div>
                                            <div class="small text-muted">@o.Customer?.Email</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-status-@o.Status px-2 py-1">@o.Status</span>
                                        </td>
                                        <td class="text-success fw-bold">$@o.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('monthlyTrendChart').getContext('2d');
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
        const ordersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyOrdersCount));
        const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Orders Count',
                        data: ordersData,
                        backgroundColor: 'rgba(245, 158, 11, 0.7)',
                        borderColor: '#f59e0b',
                        borderWidth: 1,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Revenue ($)',
                        data: revenueData,
                        type: 'line',
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.2)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        ticks: { color: '#94a3b8' },
                        grid: { color: '#334155' }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        ticks: { color: '#f59e0b' },
                        grid: { color: '#334155' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        ticks: { color: '#10b981' },
                        grid: { drawOnChartArea: false }
                    }
                },
                plugins: {
                    legend: {
                        labels: { color: '#f1f5f9' }
                    }
                }
            }
        });
    </script>
}
