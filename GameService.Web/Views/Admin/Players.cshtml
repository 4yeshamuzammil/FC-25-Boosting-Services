@model PlayerEarningsManagementViewModel
@{
    ViewData["Title"] = "Players & Earnings Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-white fw-bold mb-0"><i class="bi bi-trophy text-warning me-2"></i>Approved Boosters & Earnings</h2>
        <p class="text-secondary small mb-0">Track completed boosting orders, accumulated earnings, and execute payouts</p>
    </div>
</div>

<!-- PLAYERS GRID -->
<div class="card border-secondary mb-4">
    <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <span class="text-white fw-bold"><i class="bi bi-people text-warning me-2"></i>Booster Roster (@Model.Players.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Player #</th>
                        <th>Booster Name</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Completed Orders</th>
                        <th>Total Earned</th>
                        <th>Unpaid Balance</th>
                        <th>Paid Balance</th>
                        <th class="text-end">Payout Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Players.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                No players registered yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model.Players)
                        {
                            <tr>
                                <td class="fw-bold text-white">#@p.PlayerId</td>
                                <td class="fw-semibold text-white">@p.FullName</td>
                                <td>
                                    <div>@p.Email</div>
                                    <div class="small text-muted">@p.Phone</div>
                                </td>
                                <td>
                                    <span class="badge @(p.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">@p.Status</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@p.CompletedOrdersCount completed</span>
                                </td>
                                <td class="text-white fw-bold">$@p.TotalEarnings.ToString("N2")</td>
                                <td>
                                    @if (p.UnpaidEarnings > 0)
                                    {
                                        <span class="badge bg-warning text-dark fw-bold px-2 py-1">$@p.UnpaidEarnings.ToString("N2") Pending</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">$0.00</span>
                                    }
                                </td>
                                <td class="text-success fw-semibold">$@p.PaidEarnings.ToString("N2")</td>
                                <td class="text-end">
                                    @if (p.UnpaidEarnings > 0)
                                    {
                                        <button type="button" class="btn btn-success btn-sm fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#payoutModal-@p.PlayerId">
                                            <i class="bi bi-cash-coin me-1"></i> Mark as Paid
                                        </button>

                                        <!-- PAYOUT MODAL -->
                                        <div class="modal fade text-start" id="payoutModal-@p.PlayerId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content bg-dark border-secondary text-white">
                                                    <form asp-action="MarkEarningsAsPaid" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="playerId" value="@p.PlayerId" />
                                                        <div class="modal-header border-secondary">
                                                            <h5 class="modal-title"><i class="bi bi-cash-stack text-success me-2"></i>Confirm Payout for @p.FullName</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="text-secondary small mb-3">
                                                                Confirming will mark all currently unpaid earnings for <strong>@p.FullName</strong> as <strong>Paid</strong>.
                                                            </p>
                                                            <div class="p-3 rounded bg-black mb-3">
                                                                <div class="d-flex justify-content-between mb-1">
                                                                    <span class="text-secondary">Player:</span>
                                                                    <span class="text-white fw-bold">@p.FullName</span>
                                                                </div>
                                                                <div class="d-flex justify-content-between mb-1">
                                                                    <span class="text-secondary">Email:</span>
                                                                    <span class="text-white">@p.Email</span>
                                                                </div>
                                                                <div class="d-flex justify-content-between border-top border-secondary pt-2 mt-2">
                                                                    <span class="text-secondary fw-bold">Total Payout:</span>
                                                                    <span class="text-success fs-5 fw-bold">$@p.UnpaidEarnings.ToString("N2")</span>
                                                                </div>
                                                            </div>
                                                            <p class="small text-muted mb-0">
                                                                This action is recorded in the platform Audit Log.
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success btn-sm fw-bold">Confirm & Mark Paid</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No pending balance</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- DETAILED EARNINGS LOG -->
<div class="card border-secondary">
    <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <span class="text-white fw-bold"><i class="bi bi-clock-history text-warning me-2"></i>Recent Order Earnings Breakdown</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Earning #</th>
                        <th>Order #</th>
                        <th>Booster</th>
                        <th>Order Amount</th>
                        <th>Booster Payout</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Paid Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DetailedEarnings.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No earnings recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model.DetailedEarnings)
                        {
                            <tr>
                                <td class="fw-bold">#@e.Id</td>
                                <td><span class="badge bg-secondary">Order #@e.OrderId</span></td>
                                <td class="fw-semibold text-white">@e.Player?.FullName</td>
                                <td>$@e.Order?.Amount.ToString("N2")</td>
                                <td class="text-warning fw-bold">$@e.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(e.PaidStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@e.PaidStatus</span>
                                </td>
                                <td class="small text-secondary">@e.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="small text-secondary">@(e.PaidAt?.ToString("MMM dd, yyyy HH:mm") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
