@model PlayerDashboardViewModel
@{
    ViewData["Title"] = "Player Operations Hub";
}

<!-- PROMINENT MANDATORY LEGAL NOTICE AT THE TOP -->
<div class="legal-notice-bar mb-4">
    <div class="d-flex align-items-start gap-3">
        <i class="bi bi-shield-exclamation fs-3 text-warning flex-shrink-0"></i>
        <div>
            <h5 class="fw-bold mb-1 text-white">MANDATORY EA SPORTS FC COMPLIANCE NOTICE:</h5>
            <p class="mb-0">
                Customer EA Sports FC accounts are <strong>HIGH PRIORITY</strong>. Any misuse, loss, transfer market ban, unauthorized coin transfer, selling customer squad players, spending FC Points, password change, or issue on a client account caused by the booster will result in <strong>legal action as per the signed agreement</strong> and immediate permanent forfeiture of all accumulated earnings.
            </p>
        </div>
    </div>
</div>

<!-- PLAYER HEADER & EARNINGS STATS -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="text-white fw-bold mb-0">
            <i class="bi bi-joystick text-warning me-2"></i>Welcome, @Model.Player.FullName
        </h2>
        <span class="badge bg-success px-3 py-1 rounded-pill mt-1">Verified FC Pro Booster</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-secondary">
            <div class="card-body">
                <span class="text-secondary small text-uppercase fw-semibold">Completed Orders</span>
                <h3 class="text-white fw-bold mb-0 mt-1">@Model.CompletedOrdersCount</h3>
                <div class="text-muted small mt-1">Verified deliveries</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-secondary">
            <div class="card-body">
                <span class="text-secondary small text-uppercase fw-semibold">Total Earnings</span>
                <h3 class="text-warning fw-bold mb-0 mt-1">$@Model.TotalEarnings.ToString("N2")</h3>
                <div class="text-secondary small mt-1">70% payout share</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-secondary">
            <div class="card-body">
                <span class="text-secondary small text-uppercase fw-semibold">Pending Balance</span>
                <h3 class="text-info fw-bold mb-0 mt-1">$@Model.PendingEarnings.ToString("N2")</h3>
                <div class="text-muted small mt-1">Ready for next payout</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-secondary">
            <div class="card-body">
                <span class="text-secondary small text-uppercase fw-semibold">Paid to Date</span>
                <h3 class="text-success fw-bold mb-0 mt-1">$@Model.PaidEarnings.ToString("N2")</h3>
                <div class="text-muted small mt-1">Processed by admin</div>
            </div>
        </div>
    </div>
</div>

<!-- 1. AVAILABLE ORDERS (ATOMIC CLAIMING) -->
<div class="card border-secondary mb-4">
    <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <div>
            <span class="text-white fw-bold fs-5"><i class="bi bi-broadcast text-warning me-2"></i>Available Orders Pool (@Model.AvailableOrders.Count)</span>
            <span class="badge bg-primary ms-2">Real-Time Open Orders</span>
        </div>
        <span class="text-secondary small">First-come, first-served (Atomic claiming enforced)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Order #</th>
                        <th>Game</th>
                        <th>Service Type</th>
                        <th>Target Rank</th>
                        <th>Booster Earning (70%)</th>
                        <th>Order Date</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AvailableOrders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No open orders available right now. New customer orders will appear here automatically.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var o in Model.AvailableOrders)
                        {
                            decimal boosterCut = Math.Round(o.Amount * 0.70m, 2);
                            <tr>
                                <td class="fw-bold text-white">#@o.Id</td>
                                <td>
                                    <span class="fw-bold text-warning">@o.GameName</span>
                                </td>
                                <td>@o.ServiceType</td>
                                <td>
                                    <span class="badge bg-secondary">@o.TargetRank</span>
                                </td>
                                <td>
                                    <span class="text-success fw-bold fs-6">+$@boosterCut.ToString("N2")</span>
                                    <span class="text-muted small ms-1">(from $@o.Amount.ToString("N2"))</span>
                                </td>
                                <td class="small text-secondary">@o.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-end">
                                    <form asp-action="ClaimOrder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm fw-bold px-3 shadow">
                                            <i class="bi bi-lightning-charge-fill me-1"></i> Take This Order
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 2. MY ACTIVE ORDERS -->
<div class="card border-secondary mb-4">
    <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <span class="text-white fw-bold fs-5"><i class="bi bi-play-circle text-info me-2"></i>My In-Progress & Claimed Orders (@Model.MyActiveOrders.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Order #</th>
                        <th>Game & Service</th>
                        <th>Target Rank</th>
                        <th>Client Instructions</th>
                        <th>Your Earnings</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MyActiveOrders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">You have no active orders in progress. Take an order from the pool above.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var o in Model.MyActiveOrders)
                        {
                            decimal boosterCut = Math.Round(o.Amount * 0.70m, 2);
                            <tr>
                                <td class="fw-bold text-white">#@o.Id</td>
                                <td>
                                    <div class="fw-bold text-warning">@o.GameName</div>
                                    <div class="small text-secondary">@o.ServiceType</div>
                                </td>
                                <td><span class="badge bg-secondary">@o.TargetRank</span></td>
                                <td style="max-width: 250px;">
                                    <div class="small text-light text-truncate" title="@o.Details">
                                        @(string.IsNullOrWhiteSpace(o.Details) ? "None" : o.Details)
                                    </div>
                                </td>
                                <td class="text-success fw-bold">+$@boosterCut.ToString("N2")</td>
                                <td>
                                    <span class="badge badge-status-@o.Status px-2 py-1">@o.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (o.Status == "Assigned")
                                        {
                                            <form asp-action="StartOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@o.Id" />
                                                <button type="submit" class="btn btn-outline-info">
                                                    <i class="bi bi-play-fill me-1"></i> Start Order
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="MarkCompleted" method="post" class="d-inline ms-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@o.Id" />
                                            <button type="submit" class="btn btn-success fw-semibold" onclick="return confirm('Are you sure the rank target has been reached on this account?');">
                                                <i class="bi bi-check2-circle me-1"></i> Mark as Completed
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. MY COMPLETED ORDERS -->
<div class="card border-secondary">
    <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <span class="text-white fw-bold fs-5"><i class="bi bi-check-all text-success me-2"></i>My Completed Orders History (@Model.MyCompletedOrders.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Order #</th>
                        <th>Game & Service</th>
                        <th>Target Rank</th>
                        <th>Earnings</th>
                        <th>Completed Date</th>
                        <th>Payout Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MyCompletedOrders.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No completed orders yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var o in Model.MyCompletedOrders)
                        {
                            decimal boosterCut = Math.Round(o.Amount * 0.70m, 2);
                            var earning = Model.Player.Earnings.FirstOrDefault(e => e.OrderId == o.Id);
                            string payoutStatus = earning?.PaidStatus ?? "Unpaid";

                            <tr>
                                <td class="fw-bold">#@o.Id</td>
                                <td>
                                    <div class="fw-bold text-white">@o.GameName</div>
                                    <div class="small text-secondary">@o.ServiceType</div>
                                </td>
                                <td><span class="badge bg-secondary">@o.TargetRank</span></td>
                                <td class="text-success fw-bold">+$@boosterCut.ToString("N2")</td>
                                <td class="small text-secondary">@(o.CompletedAt?.ToString("MMM dd, yyyy HH:mm") ?? "-")</td>
                                <td>
                                    <span class="badge @(payoutStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@payoutStatus</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
