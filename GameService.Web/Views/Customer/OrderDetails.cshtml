@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id} Details";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card shadow-lg border-secondary">
            <div class="card-header bg-dark d-flex justify-content-between align-items-center py-3">
                <span class="text-white fw-bold"><i class="bi bi-box-seam text-warning me-2"></i>Order #@Model.Id Details</span>
                <span class="badge badge-status-@Model.Status px-3 py-2">@Model.Status</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label class="text-secondary small">Game & Service</label>
                        <div class="fs-5 fw-bold text-warning">@Model.GameName</div>
                        <div class="text-secondary small">@Model.ServiceType</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-secondary small">Target Rank</label>
                        <div class="fs-5 fw-bold text-white">@Model.TargetRank</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-secondary small">Total Price</label>
                        <div class="fs-4 fw-bold text-success">$@Model.Amount.ToString("N2")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-secondary small">Assigned Pro Booster</label>
                        @if (Model.AssignedPlayer != null)
                        {
                            <div class="fs-5 fw-bold text-info"><i class="bi bi-shield-check me-1"></i>@Model.AssignedPlayer.FullName</div>
                            <div class="small text-muted">Claimed: @(Model.AssignedAt?.ToString("MMM dd, yyyy HH:mm") ?? "-")</div>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">Awaiting booster claim (Open pool)</div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-secondary small fw-semibold">Order Instructions & Details</label>
                    <div class="p-3 rounded bg-black border border-secondary text-light font-monospace small">
                        @(string.IsNullOrWhiteSpace(Model.Details) ? "No special instructions provided." : Model.Details)
                    </div>
                </div>

                <div class="row g-3 text-secondary small border-top border-secondary pt-3">
                    <div class="col-sm-4">
                        <strong>Placed:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm") UTC
                    </div>
                    <div class="col-sm-4">
                        <strong>Assigned:</strong> @(Model.AssignedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Pending")
                    </div>
                    <div class="col-sm-4">
                        <strong>Completed:</strong> @(Model.CompletedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Pending")
                    </div>
                </div>

                <div class="mt-4 pt-3 text-end">
                    <a asp-action="Dashboard" class="btn btn-outline-warning">
                        <i class="bi bi-arrow-left me-1"></i> Back to My Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
